# PostgreSQL Configuration
POSTGRES_DB=cronograma_dev
POSTGRES_USER=seu_usuario
POSTGRES_PASSWORD=sua_senha_segura
POSTGRES_PORT=5432

# Application Admin User
ADMIN_NOME=seu_nome
ADMIN_EMAIL=seu_email@example.com
ADMIN_SENHA=sua_senha_segura
ADMIN_PAPEL=admin

# Security
SECRET_KEY=sua-chave-secreta-bem-grande-aqui

# Database URL (constructed from above variables)
# Local: postgresql://seu_usuario:sua_senha_segura@localhost:5432/cronograma_dev
# Docker: postgresql://seu_usuario:sua_senha_segura@postgres:5432/cronograma_dev
DATABASE_URL=postgresql://seu_usuario:sua_senha_segura@localhost:5432/cronograma_dev
